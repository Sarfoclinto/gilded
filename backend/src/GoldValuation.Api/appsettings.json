    "LockoutMinutes": 15,
    "DefaultCompany": null,
    "Issuer": "gold-valuation",
    "Audience": "gold-valuation-web",
    "SigningKey": "",
    "RefreshCookieName": "gv_refresh",
    "CookieSameSite": "Lax",
    "CookieSecure": true
  },
  "PriceFeed": {
    "Url": "https://goldbod.gov.gh/"
  },
  "Cors": { "Origins": [] },
  "Swagger": {
    "Enabled": false
  }
