{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "App": "Host=localhost;Port=5432;Database=gold;Username=gold_app;Password=db-password",
    "Migrator": "Host=localhost;Port=5432;Database=gold;Username=gold_migrator;Password=db-migrator-password"
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
