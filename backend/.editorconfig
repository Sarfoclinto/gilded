root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
[*.{json,yml,yaml,csproj,props,sql}]
indent_size = 2
[*.cs]
dotnet_style_qualification_for_field = false
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.CA1707.severity = none   # allow Method_Does_Thing test names
dotnet_diagnostic.CA1861.severity = none
