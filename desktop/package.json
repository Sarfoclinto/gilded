{
  "name": "@gold/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Gilded desktop app (Windows first): the web app inside a window that opens with no internet.",
  "author": "Gilded",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "dist": "npm run build -w @gold/web && npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.gilded.desktop",
    "productName": "Gilded",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Gilded-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/win/stable"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
