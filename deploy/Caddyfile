# SITE_ADDRESS decides everything:
#   ":80"            plain http, for the laptop demo (http://localhost)
#   "gilded.example.com"  a real domain: Caddy gets and renews the HTTPS certificate by itself
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API and live updates (SignalR WebSocket) go to the API container. Caddy passes WebSockets through without extra settings.
	@api path /api/* /hubs/* /health/*
	handle @api {
		reverse_proxy api:8080
	}

	# Desktop app updates: the installer and its latest.yml, placed by hand in deploy/updates/win/<stable|beta>/ (see desktop/README.md).
	# No fallback to index.html here: a missing file must be a real 404, and the update list is always re-read.
	handle /updates/* {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}

	# Everything else is the web app. Unknown paths fall back to index.html so page refreshes work.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header / Cache-Control "no-cache"
		# The service worker and its manifest must always be re-checked, or a device can keep running an old version.
		header /sw.js Cache-Control "no-cache"
		header /manifest.webmanifest Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}

# ---------------------------------------------------------------------------------------------------------------------
# The company website (website/ in the repository), on the bare domain, e.g. https://gildedgold.org. Plain files, nothing to build.
# WEBSITE_ADDRESS unset (the laptop demo): it listens on port 8081 inside the container only, which nothing reaches.
{$WEBSITE_ADDRESS} {
	encode zstd gzip
	root * /srv/site
	file_server
	# content.js holds the phone numbers and branches: always re-read so a change shows at once
	header /content.js Cache-Control "no-cache"
	header /index.html Cache-Control "no-cache"
	header / Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	handle_errors {
		rewrite * /index.html
		file_server
	}
}

# www.gildedgold.org sends visitors to the bare address (one address for search engines and for people).
{$WEBSITE_WWW_ADDRESS} {
	redir https://{$WEBSITE_ADDRESS}{uri} permanent
}

