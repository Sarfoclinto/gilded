# Builds the web app, then serves it with Caddy (which also proxies /api and /hubs to the API and handles HTTPS).
# Build context = the repository root.
FROM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY core-ts/package.json core-ts/
COPY web/package.json web/
# The desktop package is a workspace too (the lock file lists it) but is not built here, so its Electron download is skipped.
COPY desktop/package.json desktop/
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
RUN npm ci --workspace=@gold/web --include-workspace-root
COPY core-ts core-ts
COPY web web
# Relative address: the browser calls the same site it was loaded from, so there is no CORS to configure.
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build -w @gold/web

FROM caddy:2-alpine
COPY --from=build /src/web/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile