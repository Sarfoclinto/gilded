# Copy this file to ".env" (same folder) and change the values. Never share or commit ".env".
# Use only letters and digits in passwords and keys (no symbols): they are placed inside connection strings.

# --- Database passwords (invent three different long ones) ---
POSTGRES_PASSWORD=ChangeMeAdmin12345
GOLD_APP_PASSWORD=ChangeMeApp12345
GOLD_MIGRATOR_PASSWORD=ChangeMeMigrator12345

# --- Login tokens: at least 40 random characters. Generate:  see docs/deployment (step "Make your secrets") ---
AUTH_SIGNING_KEY=ReplaceThisWithAtLeastFortyRandomLettersAndDigits0000

# --- Your company's short code (lowercase, no spaces). People log in under this company. ---
COMPANY_SLUG=demo

# --- Where the site is reached ---
# Laptop demo:  SITE_ADDRESS=:80   COOKIE_SECURE=false   (open http://localhost)
# Real server:  SITE_ADDRESS=gilded.yourcompany.com   COOKIE_SECURE=true   (https, certificate is automatic)
SITE_ADDRESS=:80
COOKIE_SECURE=false

# --- Ports on this computer (change HTTP_PORT if 80 is already used, then open http://localhost:8080) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Backups (deploy/BACKUPS.md) ---
# Every night at 01:30 the database and the photos are backed up into ./backups (the newest 7 kept), and once a week the newest copy is
# test-loaded to prove it can be put back. Directors get a notification in the app if either fails.
# BACKUP_SCHEDULE=30 1 * * *
# BACKUP_KEEP_LOCAL=7
# Off-site copy (strongly advised: a backup on the same server is lost with the server). Backblaze B2 example:
#   create a PRIVATE bucket, then an application key limited to that bucket, and fill in:
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
# Everything sent off-site is encrypted with this passphrase first (the provider only sees scrambled files). Long, letters and digits.
# WRITE IT DOWN AND KEEP IT SOMEWHERE SAFE, AWAY FROM THE SERVER: without it the off-site copies cannot be opened by anyone.
BACKUP_ENCRYPTION_PASSPHRASE=

# --- The company website on the bare domain (docs/deployment/12-company-website.md) ---
# Leave both empty on the laptop demo. On the server, after the DNS records point here:
# WEBSITE_ADDRESS=gildedgold.org
# WEBSITE_WWW_ADDRESS=www.gildedgold.org
WEBSITE_ADDRESS=
WEBSITE_WWW_ADDRESS=

